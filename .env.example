# Veltron AI Lab — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# Required for the chat assistant to work. Server-side only — never expose to the browser.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Model identifier used for chat completions.
# Default: openrouter/auto (OpenRouter's auto router).
# Free models can be selected with the ":free" suffix, e.g. "meta-llama/llama-3.3-70b-instruct:free".
OPENROUTER_MODEL=openrouter/auto

# Optional. Port for the standalone development server.
PORT=5000
